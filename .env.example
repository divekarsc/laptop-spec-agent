# Copy to .env and add your key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: override the default model (gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: SQLite cache for cross-retailer spec aliasing (via mcp-server-sqlite / uvx)
# SQLITE_DB_PATH=data/laptop_cache.db
# MCP_SQLITE_COMMAND=uvx
# MCP_SQLITE_ARGS=mcp-server-sqlite --db-path data/laptop_cache.db
